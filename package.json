    "jose": "^6.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0"
