    "db:normalize-scoreless": "npx tsx --env-file=.env db/normalize-scoreless-games.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "npx neonctl@latest branches reset local-dev --project-id rough-credit-01845192 --parent"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
